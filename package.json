{
  "name": "seatlock",
  "private": true,
  "description": "Concert seat booking: holds, payments and on-sale concurrency done right.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "infra"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w apps/api",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces",
    "test": "npm test -w apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "synth": "npm run synth -w infra"
  },
  "engines": {
    "node": ">=20"
  }
}
